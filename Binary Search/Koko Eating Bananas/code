class Solution {
public:
    int totalhrs(vector<int>& nums,int n){
        int totalh = 0;
        for(int i=0;i<nums.size();i++){
            totalh += ceil((double)nums[i]/(double)n);
        }
        return totalh;
    }
    int findmax(vector<int>& nums){
        int maxi = 0;
        for(int i=0;i<nums.size();i++){
            maxi = max(nums[i],maxi);
        }
        return maxi;
    }
    int minEatingSpeed(vector<int>& piles, int h) {
        int n = piles.size();
        int low = 1;
        int high = findmax(piles);
        int ans = INT_MAX;
        while(low <= high){
            int mid = low + (high-low)/2;
            int total = totalhrs(piles,mid);
            if(total <= h){
                
                high = mid - 1;
            }
            else{
                low = mid + 1;
            }
        }
        return low;
    }
};
