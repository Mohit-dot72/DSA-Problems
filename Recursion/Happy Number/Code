class Solution {
public:
    bool solve(int n){
        if(n == 1) return true;
        if(n == 4) return false;

        int sum = 0;
        while(n > 0){
            int m = n%10;
            sum += m*m;
            n = n/10;
        }

        return solve(sum);
    }
    bool isHappy(int n) {
        return solve(n);
    }
};
