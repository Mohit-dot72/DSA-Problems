class Solution {
public:
    void dfs(vector<vector<char>>& grid,int r,int c){
        int row = grid.size();
        int col = grid[0].size();
        if(r < 0 || r >= row || c < 0 || c >= col || grid[r][c] != 'O'){
            return;
        }
        grid[r][c] = 'T';
        dfs(grid,r+1 ,c );
        dfs(grid,r-1 ,c );
        dfs(grid,r ,c+1 );
        dfs(grid,r ,c-1 );
        
    }
    void solve(vector<vector<char>>& board) {
        int n = board.size();
        int m = board[0].size();
        for(int i=0;i<n;i++){
            if(board[i][0] == 'O')
            dfs(board,i,0);

            if(board[i][m-1] == 'O')
            dfs(board,i,m-1);

        }

        for(int j=0;j<m;j++){
            if(board[0][j] == 'O')
            dfs(board,0,j);

            if(board[n-1][j] == 'O')
            dfs(board,n-1,j);

        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(board[i][j] == 'O'){
                    board[i][j] = 'X';
                } else if(board[i][j] == 'T'){
                    board[i][j] = 'O';
                }
            }
        }
    }
};
