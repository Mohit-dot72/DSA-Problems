class Solution {
public:
    void dfs(vector<vector<int>>& image, int r, int c,int ogColor, int color){
        int n = image.size();
        int m = image[0].size();

        if(r < 0 || r >= n || c < 0 || c >= m){
            return;
        } 
        if(image[r][c] != ogColor){
            return ;
        }
        image[r][c] = color;
        dfs(image,r+1,c,ogColor,color );
        dfs(image,r-1,c,ogColor,color );
        dfs(image,r ,c+1,ogColor,color);
        dfs(image,r ,c-1,ogColor,color);
    }
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        int ogColor = image[sr][sc];
        if(ogColor == color){
            return image;
        }
        dfs(image,sr,sc,ogColor,color);

        return image;
    }
};
