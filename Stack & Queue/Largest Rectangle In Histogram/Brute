class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int n = heights.size();
        int maxarea = 0;
        for(int i=0;i<n;i++){
            int height = heights[i];
            for(int j=i;j<n;j++){
                height = min(height,heights[j]);
                int area = height * (j-i+1);
                maxarea = max(maxarea,area);
            }
        }
        return maxarea;
    }
};
