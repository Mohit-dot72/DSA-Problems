/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    
    int maxi = 0;

    int findleftH(TreeNode* root){
        if(root == NULL) return 0;

        return 1 + max(findleftH(root->left),findleftH(root->right));
    }

    int findrightH(TreeNode* root){
        if(root == NULL) return 0;

        return 1 + max(findrightH(root->left),findrightH(root->right));
    }

    int diameterOfBinaryTree(TreeNode* root) {
        if(root == NULL) return 0;

        int lh = findleftH(root->left);
        int rh = findrightH(root->right);

        maxi = max(maxi,lh + rh);

        diameterOfBinaryTree(root->left);
        diameterOfBinaryTree(root->right);

        return maxi;
                
    }
};
