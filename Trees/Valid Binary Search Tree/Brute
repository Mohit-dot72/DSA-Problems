class Solution {
public:
    bool isValidBST(TreeNode* root) {
        vector<int> ans;
        if(root == NULL) return true;
        queue<TreeNode*> q;
        q.push(root);
        while(!q.empty()){
            int size = q.size();
            for(int i=0;i<size;i++){
                TreeNode* node = q.front();
                q.pop();
                if(node->left != NULL){
                    if(node->left->val < node->val){
                    q.push(node->left);
                  
                } else{
                    return false;
                    
                }
                }

                if(node->right != NULL){
                if(node->right->val > node->val){
                    q.push(node->right);
                   
                } else{
                    return false;
                }
                }
            }
        }
        return true;
    }
};
