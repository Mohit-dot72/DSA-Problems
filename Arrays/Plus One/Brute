class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        int n = digits.size();
        vector<int> ans;
        int curr = 1 ;
        for(int i = n-1;i>=0;i--){
            int m = digits[i] + curr;
            int t = m % 10;
            ans.push_back(t);
            curr = m / 10;
        }

        int m = digits[0] + curr;
        if(m/10 != 0){
            int t = m/10;
            ans.push_back(t);
        }

        int i = 0;
        int j = ans.size() -1;

        while(i < j){
            swap(ans[i],ans[j]);
                i++;
                j--;
            
        }
        return ans;
    }
};
